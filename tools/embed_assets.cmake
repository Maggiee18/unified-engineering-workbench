# Build-time helper (no backend logic): converts every file in UI_DIR into a
# C++ byte array so the web UI ships inside Launch.exe.
#   cmake -DUI_DIR=<dir> -DOUT=<file.cpp> -P embed_assets.cmake
file(GLOB_RECURSE files RELATIVE "${UI_DIR}" "${UI_DIR}/*")
list(SORT files)
set(body "")
set(table "")
set(i 0)
foreach(rel IN LISTS files)
  file(READ "${UI_DIR}/${rel}" hex HEX)
  string(LENGTH "${hex}" hexlen)
  math(EXPR size "${hexlen} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
  string(APPEND body "static const unsigned char kAsset${i}[] = {${bytes}0x00};\n")
  string(APPEND table "    {\"${rel}\", kAsset${i}, ${size}},\n")
  math(EXPR i "${i} + 1")
endforeach()
file(WRITE "${OUT}" "// GENERATED by tools/embed_assets.cmake - do not edit.\n"
  "#include \"server/embedded_assets.hpp\"\n#include <iterator>\n"
  "namespace wb::api {\nnamespace {\n${body}"
  "const EmbeddedAsset kAssets[] = {\n${table}};\n}  // namespace\n"
  "const EmbeddedAsset* findEmbeddedAsset(std::string_view path) noexcept {\n"
  "    for (const auto& a : kAssets) if (a.path == path) return &a;\n    return nullptr;\n}\n"
  "}  // namespace wb::api\n")
